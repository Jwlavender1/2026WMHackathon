# Keep demo until Auth0 and PostgreSQL are both ready. Live mode fails on missing configuration.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=dev-o0ar4rp3e14z4odp.us.auth0.com
AUTH0_CLIENT_ID=g3NM42mxEDRAB2wDbAdaxzJih3qw490F
AUTH0_CLIENT_SECRET=
# Server-only US city autocomplete; never prefix with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
# Server-only Google AI Studio key for Needs map insights. Optional: rules are used without it.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-flash-latest.
GEMINI_MODEL=
# Generate locally; never commit this value or prefix it with NEXT_PUBLIC_.
AUTH0_SECRET=
# Restricted runtime login, with membership in commonly_runtime only.
DATABASE_URL=
# Schema owner credentials used only by migrate/seed/role setup scripts.
MIGRATION_DATABASE_URL=
# Remote databases always verify TLS. Use the cluster CA if required.
PGSSL_MODE=verify-full
PGSSL_CA_FILE=
PGSSL_CA=
# Grant runtime permissions to this EXISTING restricted database login.
DATABASE_APP_USER=
# Seed only: must match the target database hostname.
ALLOW_DEMO_SEED=false
SEED_DATABASE_HOST=
# Optional: map fixture owners to real Auth0 user subjects (not emails).
SEED_MERCY_AUTH0_SUB=
SEED_LIBRARY_AUTH0_SUB=

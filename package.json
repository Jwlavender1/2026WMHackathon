{
  "name": "turnout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/database.test.ts tests/integration-boundaries.test.ts tests/onboarding.test.ts",
    "test:e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "format": "prettier --write .",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:grant-runtime": "tsx --env-file-if-exists=.env.local scripts/grant-runtime.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.30.0",
    "lucide-react": "1.48.0",
    "luxon": "3.7.2",
    "motion": "13.4.4",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.5",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
